# ==== Configuración Ferresur La 48 ====
# Copia este archivo como .env y rellena los valores reales.
# Vite solo expone al navegador las variables que empiezan por VITE_.

# Webhook de n8n que DEVUELVE el inventario (GET). Responde JSON.
VITE_N8N_INVENTARIO_URL=https://TU-INSTANCIA-N8N/webhook/ferresur-inventario

# Webhook de n8n que RECIBE la cotización (POST) y la manda al WhatsApp de Ferresur.
VITE_N8N_COTIZACION_URL=https://TU-INSTANCIA-N8N/webhook/ferresur-cotizacion

# Número de WhatsApp de Ferresur (con código de país, sin + ni espacios).
# Se usa como respaldo wa.me si el webhook no estuviera disponible.
VITE_WHATSAPP_NUMERO=573145851371
